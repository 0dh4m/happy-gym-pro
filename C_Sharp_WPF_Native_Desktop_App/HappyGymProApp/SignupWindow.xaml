<Window x:Class="HappyGymProApp.SignupWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Happy Gym PRO | إنشاء حساب" Height="740" Width="520"
        Background="{DynamicResource BgDeep}"
        WindowStartupLocation="CenterScreen"
        ResizeMode="NoResize"
        WindowStyle="None"
        AllowsTransparency="True"
        Loaded="Window_Loaded"
        MouseLeftButtonDown="Window_MouseDown">

    <Grid>
        <!-- خلفية الفضاء -->
        <Canvas x:Name="SpaceCanvas" IsHitTestVisible="False" Panel.ZIndex="-1" FlowDirection="LeftToRight"/>

        <!-- زر المظهر مقاد في القنت الفوقاني على اليسار -->
        <Button x:Name="BtnThemeToggle" Width="40" Height="40" Style="{DynamicResource GlassButton}" 
                VerticalAlignment="Top" HorizontalAlignment="Left" Margin="20,20,0,0" 
                Click="BtnThemeToggle_Click" Panel.ZIndex="1000" ToolTip="تبديل المظهر">
            <TextBlock x:Name="TxtThemeIcon" Text="🌙" FontSize="18" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0,0,0,2"/>
        </Button>

        <!-- زر الإغلاق في القنت الفوقاني على اليمين -->
        <Button Width="40" Height="40" Style="{DynamicResource GlassButton}" Foreground="#f87171"
                VerticalAlignment="Top" HorizontalAlignment="Right" Margin="0,20,20,0" 
                Click="BtnClose_Click" Panel.ZIndex="1000" ToolTip="إغلاق التطبيق">
            <TextBlock Text="✕" FontSize="16" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center"/>
        </Button>

        <!-- البطاقة الزجاجية -->
        <Border Style="{DynamicResource GlassCard}" Margin="35,60,35,35" Padding="40" VerticalAlignment="Center" FlowDirection="RightToLeft">
            <StackPanel>

                <StackPanel HorizontalAlignment="Center" Margin="0,0,0,25">
                    <TextBlock Text="انضم إلى Happy Gym PRO" Foreground="{DynamicResource TextPrimary}" FontWeight="ExtraBold" FontSize="22" HorizontalAlignment="Center"/>
                    <TextBlock Text="أنشئ حسابك وابدأ رحلة التغذية الذكية" Foreground="{DynamicResource TextMuted}" FontSize="14" HorizontalAlignment="Center" Margin="0,4,0,0"/>
                </StackPanel>

                <!-- رسالة الخطأ -->
                <Border x:Name="BorderError" Background="#26f87171" BorderBrush="#f87171" BorderThickness="1" CornerRadius="10" Padding="12" Margin="0,0,0,15" Visibility="Collapsed">
                    <TextBlock x:Name="TxtErrorMsg" Text="" Foreground="#f87171" FontSize="13" TextWrapping="Wrap" FontWeight="SemiBold" TextAlignment="Center"/>
                </Border>

                <!-- الحقول -->
                <TextBlock Text="الاسم الكامل:" Foreground="{DynamicResource TextMuted}" FontSize="13" FontWeight="SemiBold" Margin="0,0,0,6"/>
                <TextBox x:Name="TxtName" Margin="0,0,0,15"/>

                <TextBlock Text="البريد الإلكتروني:" Foreground="{DynamicResource TextMuted}" FontSize="13" FontWeight="SemiBold" Margin="0,0,0,6"/>
                <TextBox x:Name="TxtEmail" FlowDirection="LeftToRight" Margin="0,0,0,15"/>

                <TextBlock Text="رقم الواتساب:" Foreground="{DynamicResource TextMuted}" FontSize="13" FontWeight="SemiBold" Margin="0,0,0,6"/>
                <Grid FlowDirection="LeftToRight" Margin="0,0,0,15">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="140"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <!-- ComboBox رجعناه للستايل الداخلي ديالو كيف ما كان -->
                    <ComboBox x:Name="CmbCountry" Grid.Column="0" SelectedValuePath="Code" Padding="8,8" 
                              Background="{DynamicResource BgInput}" 
                              Foreground="{DynamicResource TextPrimary}" 
                              BorderBrush="{DynamicResource BorderGlass}" 
                              Margin="0,0,8,0">
                        <ComboBox.Style>
                            <Style TargetType="ComboBox">
                                <Setter Property="Background" Value="{DynamicResource BgInput}"/>
                                <Setter Property="Foreground" Value="{DynamicResource TextPrimary}"/>
                                <Setter Property="BorderBrush" Value="{DynamicResource BorderGlass}"/>
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="ComboBox">
                                            <Grid>
                                                <Border x:Name="Border" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="1" CornerRadius="12">
                                                    <Grid>
                                                        <ToggleButton x:Name="ToggleButton" Background="Transparent" BorderBrush="Transparent" Focusable="false" IsChecked="{Binding IsDropDownOpen, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}" ClickMode="Press">
                                                            <ToggleButton.Template>
                                                                <ControlTemplate TargetType="ToggleButton">
                                                                    <Border Background="Transparent">
                                                                        <Path x:Name="Arrow" Data="M 0 0 L 4 4 L 8 0 Z" Fill="{DynamicResource TextPrimary}" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,12,0"/>
                                                                    </Border>
                                                                </ControlTemplate>
                                                            </ToggleButton.Template>
                                                        </ToggleButton>
                                                        <ContentPresenter x:Name="ContentSite" IsHitTestVisible="False" Content="{TemplateBinding SelectionBoxItem}" ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}" ContentTemplateSelector="{TemplateBinding ItemTemplateSelector}" Margin="12,0,30,0" VerticalAlignment="Center" HorizontalAlignment="Right"/>
                                                    </Grid>
                                                </Border>
                                                <Popup x:Name="Popup" Placement="Bottom" IsOpen="{TemplateBinding IsDropDownOpen}" AllowsTransparency="True" Focusable="False" PopupAnimation="Slide">
                                                    <Border x:Name="DropDownBorder" Background="{DynamicResource BgSurface}" BorderBrush="{DynamicResource BorderGlass}" BorderThickness="1" CornerRadius="8" MaxHeight="{TemplateBinding MaxDropDownHeight}" MinWidth="{TemplateBinding ActualWidth}" Margin="0,4,0,0">
                                                        <ScrollViewer x:Name="DropDownScrollViewer" Margin="4" SnapsToDevicePixels="True">
                                                            <ItemsPresenter x:Name="ItemsPresenter" KeyboardNavigation.DirectionalNavigation="Contained"/>
                                                        </ScrollViewer>
                                                    </Border>
                                                </Popup>
                                            </Grid>
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                            </Style>
                        </ComboBox.Style>
                        <ComboBox.ItemContainerStyle>
                            <Style TargetType="ComboBoxItem">
                                <Setter Property="Background" Value="Transparent"/>
                                <Setter Property="Foreground" Value="{DynamicResource TextPrimary}"/>
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="ComboBoxItem">
                                            <Border x:Name="ItemBorder" Background="Transparent" Padding="10,8" CornerRadius="6">
                                                <ContentPresenter/>
                                            </Border>
                                            <ControlTemplate.Triggers>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter TargetName="ItemBorder" Property="Background" Value="{DynamicResource BgInput}"/>
                                                </Trigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                            </Style>
                        </ComboBox.ItemContainerStyle>
                        <ComboBox.ItemTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding DisplayText}" Foreground="{DynamicResource TextPrimary}" FontSize="13" FontWeight="SemiBold"/>
                            </DataTemplate>
                        </ComboBox.ItemTemplate>
                    </ComboBox>

                    <!-- خانة الهاتف -->
                    <TextBox x:Name="TxtPhone" Grid.Column="1" FontWeight="Bold"/>
                </Grid>

                <TextBlock Text="كلمة المرور:" Foreground="{DynamicResource TextMuted}" FontSize="13" FontWeight="SemiBold" Margin="0,0,0,6"/>
                <PasswordBox x:Name="TxtPassword" FlowDirection="LeftToRight" Margin="0,0,0,25"/>

                <!-- زر التسجيل -->
                <Button x:Name="BtnSignup" Content="تسجيل حساب جديد 🚀" Style="{DynamicResource PrimaryButton}" Height="50" Click="BtnSignup_Click" Margin="0,0,0,20"/>

                <!-- رابط تسجيل الدخول -->
                <TextBlock HorizontalAlignment="Center" FontSize="14">
                    <Run Text="لديك حساب بالفعل؟ " Foreground="{DynamicResource TextMuted}"/>
                    <Run Text="سجل دخولك هنا" Foreground="{DynamicResource AccentAmber}" FontWeight="Bold" Cursor="Hand" MouseDown="OpenLogin_MouseDown"/>
                </TextBlock>

            </StackPanel>
        </Border>
    </Grid>
</Window>