<Window x:Class="HappyGymProApp.LoginWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Happy Gym PRO | تسجيل الدخول" Height="640" Width="520"
        Background="{DynamicResource BgDeep}"
        WindowStartupLocation="CenterScreen"
        ResizeMode="NoResize"
        WindowStyle="None"
        AllowsTransparency="True"
        MouseLeftButtonDown="Window_MouseDown">

    <Grid>
        <!-- خلفية الفضاء -->
        <Canvas x:Name="SpaceCanvas" IsHitTestVisible="False" Panel.ZIndex="-1" FlowDirection="LeftToRight"/>

        <!-- زر الهلال مقاد في القنت الفوقاني على اليسار بمسافة نقية -->
        <Button x:Name="BtnThemeToggle" Width="40" Height="40" Style="{DynamicResource GlassButton}" 
                VerticalAlignment="Top" HorizontalAlignment="Left" Margin="20,20,0,0" 
                Click="BtnThemeToggle_Click" Panel.ZIndex="1000" ToolTip="تبديل المظهر">
            <TextBlock x:Name="TxtThemeIcon" Text="🌙" FontSize="18" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0,0,0,2"/>
        </Button>

        <!-- زر الإغلاق (جديد) في القنت الفوقاني على اليمين -->
        <Button Width="40" Height="40" Style="{DynamicResource GlassButton}" Foreground="#f87171"
                VerticalAlignment="Top" HorizontalAlignment="Right" Margin="0,20,20,0" 
                Click="BtnClose_Click" Panel.ZIndex="1000" ToolTip="إغلاق التطبيق">
            <TextBlock Text="✕" FontSize="16" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center"/>
        </Button>

        <!-- البطاقة الزجاجية -->
        <Border Style="{DynamicResource GlassCard}" Margin="35,60,35,35" Padding="40" VerticalAlignment="Center" FlowDirection="RightToLeft">
            <StackPanel>

                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0,0,0,25">
                    <Border Background="#26f59e0b" Width="60" Height="60" CornerRadius="18" HorizontalAlignment="Center" Margin="0,0,0,15">
                        <TextBlock Text="⚡" FontSize="28" Foreground="{DynamicResource AccentAmber}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <TextBlock Text="مرحباً بك مجدداً كابتن!" Foreground="{DynamicResource TextPrimary}" FontWeight="ExtraBold" FontSize="22" HorizontalAlignment="Center"/>
                    <TextBlock Text="سجل دخولك لمتابعة خطتك الغذائية والرياضية" Foreground="{DynamicResource TextMuted}" FontSize="13" HorizontalAlignment="Center" Margin="0,6,0,0"/>
                </StackPanel>

                <Border x:Name="BorderError" Background="#26f87171" BorderBrush="#f87171" BorderThickness="1" CornerRadius="10" Padding="12" Margin="0,0,0,15" Visibility="Collapsed">
                    <TextBlock x:Name="TxtErrorMsg" Text="" Foreground="#f87171" FontSize="13" TextWrapping="Wrap" FontWeight="SemiBold" TextAlignment="Center"/>
                </Border>

                <TextBlock Text="البريد الإلكتروني:" Foreground="{DynamicResource TextMuted}" FontSize="13" FontWeight="SemiBold" Margin="0,0,0,6"/>
                <TextBox x:Name="TxtEmail" FlowDirection="LeftToRight" Margin="0,0,0,15"/>

                <TextBlock Text="كلمة المرور:" Foreground="{DynamicResource TextMuted}" FontSize="13" FontWeight="SemiBold" Margin="0,0,0,6"/>
                <PasswordBox x:Name="TxtPassword" FlowDirection="LeftToRight" Margin="0,0,0,10"/>

                <TextBlock Text="نسيت كلمة المرور؟" Foreground="{DynamicResource AccentAmber}" FontSize="13" FontWeight="Bold" HorizontalAlignment="Left" Margin="0,0,0,20" Cursor="Hand" MouseDown="ForgotPassword_MouseDown"/>

                <Button x:Name="BtnLogin" Content="تسجيل الدخول 🚀" Style="{DynamicResource PrimaryButton}" Height="50" Click="BtnLogin_Click" Margin="0,0,0,15"/>

                <TextBlock HorizontalAlignment="Center" FontSize="14">
                    <Run Text="ليس لديك حساب بعد؟ " Foreground="{DynamicResource TextMuted}"/>
                    <Run Text="أنشئ حسابك الآن" Foreground="{DynamicResource AccentAmber}" FontWeight="Bold" Cursor="Hand" MouseDown="OpenSignup_MouseDown"/>
                </TextBlock>

            </StackPanel>
        </Border>
    </Grid>
</Window>