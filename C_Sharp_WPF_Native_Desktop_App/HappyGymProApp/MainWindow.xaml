<Window x:Class="HappyGymProApp.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Happy Meal Planner PRO" Height="840" Width="1220"
        Background="{DynamicResource BgDeep}"
        WindowStartupLocation="CenterScreen"
        WindowState="Maximized"
        WindowStyle="None"
        ResizeMode="CanResize"
        MaxHeight="{x:Static SystemParameters.MaximizedPrimaryScreenHeight}"
        MaxWidth="{x:Static SystemParameters.MaximizedPrimaryScreenWidth}"
        Loaded="Window_Loaded">

    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="0" ResizeBorderThickness="4" GlassFrameThickness="0" CornerRadius="0"/>
    </WindowChrome.WindowChrome>

    <Window.Resources>
        <!-- ستايل شيبس المكونات (CheckBox Chips) الزجاجي -->
        <Style x:Key="ChipCheckBox" TargetType="CheckBox">
            <Setter Property="Foreground" Value="{DynamicResource TextPrimary}"/>
            <Setter Property="Margin" Value="0,0,8,8"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="CheckBox">
                        <Border x:Name="border" Background="{DynamicResource BgInput}" BorderBrush="{DynamicResource BorderGlass}" BorderThickness="1" CornerRadius="16" Padding="12,6">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#33F59E0B"/>
                                <Setter TargetName="border" Property="BorderBrush" Value="{DynamicResource AccentAmber}"/>
                                <Setter Property="Foreground" Value="{DynamicResource AccentAmber}"/>
                                <Setter Property="FontWeight" Value="Bold"/>
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="BorderBrush" Value="{DynamicResource AccentAmber}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ستايل الكومبو بوكس الزجاجي مقاد وموسع -->
        <Style x:Key="GlassComboBox" TargetType="ComboBox">
            <Setter Property="Background" Value="{DynamicResource BgInput}"/>
            <Setter Property="Foreground" Value="{DynamicResource TextPrimary}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource BorderGlass}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBox">
                        <Grid>
                            <Border x:Name="Border" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="10">
                                <Grid>
                                    <ToggleButton x:Name="ToggleButton" Background="Transparent" BorderBrush="Transparent" Focusable="false" IsChecked="{Binding IsDropDownOpen, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}" ClickMode="Press">
                                        <ToggleButton.Template>
                                            <ControlTemplate TargetType="ToggleButton">
                                                <Border Background="Transparent">
                                                    <Path x:Name="Arrow" Data="M 0 0 L 5 5 L 10 0 Z" Fill="{DynamicResource TextMuted}" HorizontalAlignment="Left" VerticalAlignment="Center" Margin="15,0,0,0"/>
                                                </Border>
                                            </ControlTemplate>
                                        </ToggleButton.Template>
                                    </ToggleButton>
                                    <ContentPresenter x:Name="ContentSite" IsHitTestVisible="False" Content="{TemplateBinding SelectionBoxItem}" ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}" ContentTemplateSelector="{TemplateBinding ItemTemplateSelector}" Margin="40,0,15,0" VerticalAlignment="Center" HorizontalAlignment="Right"/>
                                </Grid>
                            </Border>
                            <Popup x:Name="Popup" Placement="Bottom" IsOpen="{TemplateBinding IsDropDownOpen}" AllowsTransparency="True" Focusable="False" PopupAnimation="Slide">
                                <Border x:Name="DropDownBorder" Background="{DynamicResource BgSurface}" BorderBrush="{DynamicResource BorderGlass}" BorderThickness="1" CornerRadius="8" MinWidth="{TemplateBinding ActualWidth}" Margin="0,4,0,0">
                                    <ScrollViewer x:Name="DropDownScrollViewer" Margin="4" SnapsToDevicePixels="True">
                                        <ItemsPresenter x:Name="ItemsPresenter" KeyboardNavigation.DirectionalNavigation="Contained"/>
                                    </ScrollViewer>
                                </Border>
                            </Popup>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="ComboBoxItem">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="{DynamicResource TextPrimary}"/>
            <Setter Property="Padding" Value="15,10"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBoxItem">
                        <Border x:Name="ItemBorder" Background="Transparent" Padding="{TemplateBinding Padding}" CornerRadius="6">
                            <ContentPresenter/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="ItemBorder" Property="Background" Value="{DynamicResource BgInput}"/>
                                <Setter Property="Foreground" Value="{DynamicResource AccentAmber}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid>
        <Canvas x:Name="SpaceCanvas" IsHitTestVisible="False" Panel.ZIndex="-1" FlowDirection="LeftToRight"/>

        <!-- شريط العنوان للتحكم في النافذة -->
        <Border x:Name="FloatingTitleBar" VerticalAlignment="Top" HorizontalAlignment="Stretch" 
                Background="{DynamicResource BgSurface}" BorderBrush="{DynamicResource BorderGlass}" BorderThickness="0,0,0,1"
                Height="34" Panel.ZIndex="1000" Visibility="Collapsed"
                MouseLeave="FloatingTitleBar_MouseLeave"
                MouseLeftButtonDown="TitleBar_MouseDown"
                FlowDirection="RightToLeft">
            <Grid Margin="15,0">
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                    <TextBlock Text="Happy Meal Planner PRO" Foreground="{DynamicResource TextPrimary}" FontSize="12" FontWeight="Bold" Margin="0,0,8,0"/>
                    <TextBlock Text="⚡" Foreground="{DynamicResource AccentAmber}" FontSize="13"/>
                </StackPanel>

                <StackPanel Orientation="Horizontal" HorizontalAlignment="Left" VerticalAlignment="Center" FlowDirection="LeftToRight">
                    <Button Content="—" Width="38" Height="28" Background="Transparent" Foreground="{DynamicResource TextMuted}" BorderThickness="0" Click="BtnMinimize_Click" Cursor="Hand" FontSize="14" FontWeight="Bold"/>
                    <Button x:Name="BtnMaximize" Content="❐" Width="38" Height="28" Background="Transparent" Foreground="{DynamicResource TextMuted}" BorderThickness="0" Click="BtnMaximize_Click" Cursor="Hand" FontSize="13"/>
                    <Button Content="✕" Width="38" Height="28" Background="Transparent" Foreground="#f87171" BorderThickness="0" Click="BtnClose_Click" Cursor="Hand" FontSize="14" FontWeight="Bold"/>
                </StackPanel>
            </Grid>
        </Border>

        <Grid Margin="16,36,16,10" FlowDirection="RightToLeft">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- Navbar -->
            <Border Grid.Row="0" Style="{DynamicResource GlassCard}" Padding="16,12" Margin="0,0,0,15">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <!-- الجهة اليمنى: اللوغو -->
                    <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock Text="⚡" Foreground="{DynamicResource AccentAmber}" FontSize="22" Margin="0,0,6,0" VerticalAlignment="Center"/>
                        <Border Background="{DynamicResource AccentAmber}" CornerRadius="4" Padding="5,2" Margin="0,0,10,0" VerticalAlignment="Center">
                            <TextBlock Text="PRO" Foreground="Black" FontWeight="ExtraBold" FontSize="10"/>
                        </Border>
                        <TextBlock Text="Happy Meal Planner" Foreground="{DynamicResource TextPrimary}" FontWeight="ExtraBold" FontSize="18" VerticalAlignment="Center"/>
                        <Button x:Name="BtnThemeToggle" Style="{DynamicResource GlassButton}" Padding="10,6" Margin="15,0,0,0" Click="BtnThemeToggle_Click" ToolTip="تبديل المظهر">
                            <TextBlock x:Name="TxtThemeIcon" Text="🌙" FontSize="16" Foreground="{DynamicResource AccentAmber}" VerticalAlignment="Center"/>
                        </Button>
                    </StackPanel>

                    <!-- الجهة اليسرى: أزرار التصفح والأفاتار -->
                    <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                        <Button x:Name="BtnNavCalc" Style="{DynamicResource GlassButton}" Padding="14,8" Margin="0,0,10,0" Click="Nav_Calculator_Click">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="🧮" Foreground="{DynamicResource AccentAmber}" VerticalAlignment="Center"/>
                                <TextBlock Text="الحاسبة" VerticalAlignment="Center" FontSize="13" FontWeight="SemiBold" Margin="0,0,8,0"/>
                            </StackPanel>
                        </Button>

                        <Button x:Name="BtnNavSaved" Style="{DynamicResource GlassButton}" Padding="14,8" Margin="0,0,10,0" Click="Nav_Saved_Click">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="🔖" Foreground="{DynamicResource AccentAmber}" VerticalAlignment="Center"/>
                                <TextBlock Text="الوجبات المحفوظة" VerticalAlignment="Center" FontSize="13" FontWeight="SemiBold" Margin="0,0,8,0"/>
                            </StackPanel>
                        </Button>

                        <Button x:Name="BtnNavPlanner" Style="{DynamicResource PrimaryButton}" Padding="14,8" Margin="0,0,10,0" Click="Nav_Planner_Click">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="🍴" VerticalAlignment="Center"/>
                                <TextBlock Text="مولد الوجبات" VerticalAlignment="Center" FontSize="14" FontWeight="Bold" Margin="0,0,8,0"/>
                            </StackPanel>
                        </Button>

                        <Button Style="{DynamicResource GlassButton}" Padding="14,8" Margin="0,0,10,0" Click="OpenProfileModal_Click">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="👤" Foreground="{DynamicResource AccentAmber}" VerticalAlignment="Center"/>
                                <TextBlock Text="الملف الشخصي" VerticalAlignment="Center" FontSize="13" FontWeight="SemiBold" Margin="0,0,8,0"/>
                            </StackPanel>
                        </Button>

                        <Button Style="{DynamicResource GlassButton}" Foreground="#f87171" BorderBrush="#33f87171" Background="#1Af87171" Padding="14,8" Margin="0,0,15,0" Click="Logout_Click" ToolTip="تسجيل الخروج">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="🚪" FontSize="14" VerticalAlignment="Center"/>
                                <TextBlock Text="خروج" VerticalAlignment="Center" FontSize="13" FontWeight="SemiBold" Margin="0,0,8,0"/>
                            </StackPanel>
                        </Button>

                        <Border Width="40" Height="40" CornerRadius="20" BorderBrush="{DynamicResource BorderGlass}" BorderThickness="2" Background="{DynamicResource BgInput}">
                            <Image x:Name="ImgUserAvatar" Stretch="UniformToFill">
                                <Image.Clip>
                                    <EllipseGeometry Center="20,20" RadiusX="20" RadiusY="20"/>
                                </Image.Clip>
                            </Image>
                        </Border>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- منطقة الشاشات -->
            <Grid Grid.Row="1">

                <!-- شاشة 1: مولد الوجبات -->
                <Grid x:Name="ViewPlanner" Visibility="Visible">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="6.2*"/>
                        <ColumnDefinition Width="5.8*"/>
                    </Grid.ColumnDefinitions>

                    <Border Grid.Column="0" Style="{DynamicResource GlassCard}" Padding="16" Margin="0,0,8,0">
                        <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="0,0,10,25">
                            <StackPanel>
                                <TextBlock Text="تحديد السعرات والمكونات" Foreground="{DynamicResource AccentAmber}" FontWeight="Bold" FontSize="16" Margin="0,0,0,15"/>

                                <Border Background="{DynamicResource BgInput}" CornerRadius="10" Padding="10" Margin="0,0,0,15" BorderBrush="{DynamicResource BorderGlass}" BorderThickness="1">
                                    <StackPanel>
                                        <TextBlock Text="🔥 السعرات الحرارية المطلوبة في هذه الوجبة (Kcal)" Foreground="{DynamicResource TextPrimary}" FontWeight="Bold" FontSize="12" Margin="0,0,0,8"/>
                                        <TextBox x:Name="TxtPlannerCalories" Text="700" FontWeight="Bold" FontSize="14" Foreground="{DynamicResource AccentAmber}" Padding="10,8"/>
                                    </StackPanel>
                                </Border>

                                <Border Background="{DynamicResource BgInput}" CornerRadius="10" Padding="10" Margin="0,0,0,20" BorderBrush="{DynamicResource BorderGlass}" BorderThickness="1">
                                    <StackPanel>
                                        <TextBlock Text="📷 أو ارفع صورة للمكونات / الثلاجة (اختياري):" Foreground="{DynamicResource TextPrimary}" FontWeight="Bold" FontSize="12" Margin="0,0,0,8"/>
                                        <Border Background="{DynamicResource BgSurface}" BorderBrush="{DynamicResource BorderGlass}" BorderThickness="1" CornerRadius="8" Padding="5,4">
                                            <DockPanel>
                                                <Button Content="Choose File" Style="{DynamicResource GlassButton}" DockPanel.Dock="Right" Padding="8,4" Click="ChooseMealImage_Click"/>
                                                <TextBlock x:Name="LblChosenFileName" Text="No file chosen" Foreground="{DynamicResource TextMuted}" FontSize="11" VerticalAlignment="Center" Margin="8,0,0,0"/>
                                            </DockPanel>
                                        </Border>
                                        <TextBlock Text="الذكاء الاصطناعي سيقوم بقراءة الصورة واستخراج المكونات تلقائياً." Foreground="{DynamicResource TextMuted}" FontSize="11" Margin="0,8,0,0"/>
                                    </StackPanel>
                                </Border>

                                <TextBlock Text="🌾 1. الكربوهيدرات ومصادر الطاقة:" Foreground="{DynamicResource AccentAmber}" FontWeight="Bold" FontSize="13" Margin="0,0,0,8"/>
                                <WrapPanel x:Name="PanelCarbs" Margin="0,0,0,15">
                                    <CheckBox Content="الأرز" Style="{StaticResource ChipCheckBox}" IsChecked="True"/>
                                    <CheckBox Content="المعكرونة" Style="{StaticResource ChipCheckBox}"/>
                                    <CheckBox Content="الشوفان" Style="{StaticResource ChipCheckBox}" IsChecked="True"/>
                                    <CheckBox Content="البطاطس" Style="{StaticResource ChipCheckBox}"/>
                                    <CheckBox Content="البطاطا الحلوة" Style="{StaticResource ChipCheckBox}"/>
                                    <CheckBox Content="الخبز" Style="{StaticResource ChipCheckBox}"/>
                                    <CheckBox Content="الكسكس" Style="{StaticResource ChipCheckBox}"/>
                                    <CheckBox Content="الكينوا" Style="{StaticResource ChipCheckBox}"/>
                                    <CheckBox Content="الذرة" Style="{StaticResource ChipCheckBox}"/>
                                    <CheckBox Content="التوست" Style="{StaticResource ChipCheckBox}"/>
                                    <CheckBox Content="الشعير" Style="{StaticResource ChipCheckBox}"/>
                                    <CheckBox Content="البرغل" Style="{StaticResource ChipCheckBox}"/>
                                    <CheckBox Content="البسكويت" Style="{StaticResource ChipCheckBox}"/>
                                    <CheckBox Content="رقائق الذرة" Style="{StaticResource ChipCheckBox}"/>
                                    <CheckBox Content="النشاء" Style="{StaticResource ChipCheckBox}"/>
                                    <CheckBox Content="طحين القمح" Style="{StaticResource ChipCheckBox}"/>
                                    <CheckBox Content="نودلز" Style="{StaticResource ChipCheckBox}"/>
                                    <CheckBox Content="الكعك" Style="{StaticResource ChipCheckBox}"/>
                                    <CheckBox Content="التمر" Style="{StaticResource ChipCheckBox}"/>
                                    <CheckBox Content="الزبيب" Style="{StaticResource ChipCheckBox}"/>
                                    <CheckBox Content="التين" Style="{StaticResource ChipCheckBox}"/>
                                    <CheckBox Content="الموز" Style="{StaticResource ChipCheckBox}"/>
                                    <CheckBox Content="عجينة البيتزا" Style="{StaticResource ChipCheckBox}"/>
                                    <CheckBox Content="الكرواسون" Style="{StaticResource ChipCheckBox}"/>
                                    <CheckBox Content="الفطير" Style="{StaticResource ChipCheckBox}"/>
                                </WrapPanel>

                                <TextBlock Text="🍗 2. مصادر البروتين واللحوم والأجبان:" Foreground="{DynamicResource AccentAmber}" FontWeight="Bold" FontSize="13" Margin="0,0,0,8"/>
                                <WrapPanel x:Name="PanelProtein" Margin="0,0,0,15">
                                    <CheckBox Content="دجاج" Style="{StaticResource ChipCheckBox}" IsChecked="True"/>
                                    <CheckBox Content="لحم مفروم" Style="{StaticResource ChipCheckBox}"/>
                                    <CheckBox Content="لحم بقري" Style="{StaticResource ChipCheckBox}"/>
                                    <CheckBox Content="بيض" Style="{StaticResource ChipCheckBox}" IsChecked="True"/>
                                    <CheckBox Content="التونة" Style="{StaticResource ChipCheckBox}"/>
                                    <CheckBox Content="السلمون" Style="{StaticResource ChipCheckBox}"/>
                                    <CheckBox Content="واي بروتين" Style="{StaticResource ChipCheckBox}"/>
                                    <CheckBox Content="ديك رومي" Style="{StaticResource ChipCheckBox}"/>
                                    <CheckBox Content="لحم غنمي" Style="{StaticResource ChipCheckBox}"/>
                                    <CheckBox Content="سردين" Style="{StaticResource ChipCheckBox}"/>
                                    <CheckBox Content="مكريل" Style="{StaticResource ChipCheckBox}"/>
                                    <CheckBox Content="سمك القد" Style="{StaticResource ChipCheckBox}"/>
                                    <CheckBox Content="الجمبري" Style="{StaticResource ChipCheckBox}"/>
                                    <CheckBox Content="جبن قريش" Style="{StaticResource ChipCheckBox}"/>
                                    <CheckBox Content="جبن أبيض" Style="{StaticResource ChipCheckBox}"/>
                                    <CheckBox Content="جبن أحمر" Style="{StaticResource ChipCheckBox}"/>
                                    <CheckBox Content="جبن موزاريلا" Style="{StaticResource ChipCheckBox}"/>
                                    <CheckBox Content="الحليب" Style="{StaticResource ChipCheckBox}"/>
                                    <CheckBox Content="اللبن" Style="{StaticResource ChipCheckBox}"/>
                                    <CheckBox Content="ياغورت يوناني" Style="{StaticResource ChipCheckBox}"/>
                                    <CheckBox Content="كازين" Style="{StaticResource ChipCheckBox}"/>
                                    <CheckBox Content="لحم عجل" Style="{StaticResource ChipCheckBox}"/>
                                    <CheckBox Content="مرق اللحم" Style="{StaticResource ChipCheckBox}"/>
                                    <CheckBox Content="السجق" Style="{StaticResource ChipCheckBox}"/>
                                    <CheckBox Content="المرتديلا" Style="{StaticResource ChipCheckBox}"/>
                                    <CheckBox Content="سمك الهامور" Style="{StaticResource ChipCheckBox}"/>
                                    <CheckBox Content="سمك التراوت" Style="{StaticResource ChipCheckBox}"/>
                                    <CheckBox Content="جبن ريكوتا" Style="{StaticResource ChipCheckBox}"/>
                                    <CheckBox Content="جبن بارميزان" Style="{StaticResource ChipCheckBox}"/>
                                    <CheckBox Content="كريمة الطبخ" Style="{StaticResource ChipCheckBox}"/>
                                    <CheckBox Content="بروتين الصويا" Style="{StaticResource ChipCheckBox}"/>
                                    <CheckBox Content="التوفو" Style="{StaticResource ChipCheckBox}"/>
                                    <CheckBox Content="نقانق" Style="{StaticResource ChipCheckBox}"/>
                                    <CheckBox Content="برغر" Style="{StaticResource ChipCheckBox}"/>
                                </WrapPanel>

                                <TextBlock Text="🥦 3. الخضروات:" Foreground="{DynamicResource AccentAmber}" FontWeight="Bold" FontSize="13" Margin="0,0,0,8"/>
                                <WrapPanel x:Name="PanelVeggies" Margin="0,0,0,15">
                                    <CheckBox Content="بروكلي" Style="{StaticResource ChipCheckBox}" IsChecked="True"/>
                                    <CheckBox Content="سبانخ" Style="{StaticResource ChipCheckBox}"/>
                                    <CheckBox Content="خس" Style="{StaticResource ChipCheckBox}"/>
                                    <CheckBox Content="طماطم" Style="{StaticResource ChipCheckBox}"/>
                                    <CheckBox Content="جزر" Style="{StaticResource ChipCheckBox}"/>
                                    <CheckBox Content="بصل" Style="{StaticResource ChipCheckBox}"/>
                                    <CheckBox Content="ثوم" Style="{StaticResource ChipCheckBox}"/>
                                    <CheckBox Content="فلفل حلو" Style="{StaticResource ChipCheckBox}"/>
                                    <CheckBox Content="خيار" Style="{StaticResource ChipCheckBox}"/>
                                    <CheckBox Content="ملفوف" Style="{StaticResource ChipCheckBox}"/>
                                    <CheckBox Content="قرنبيط" Style="{StaticResource ChipCheckBox}"/>
                                    <CheckBox Content="كوسة" Style="{StaticResource ChipCheckBox}"/>
                                    <CheckBox Content="بازلاء" Style="{StaticResource ChipCheckBox}"/>
                                    <CheckBox Content="فاصوليا خضراء" Style="{StaticResource ChipCheckBox}"/>
                                    <CheckBox Content="قرع عسلي" Style="{StaticResource ChipCheckBox}"/>
                                    <CheckBox Content="بنجر" Style="{StaticResource ChipCheckBox}"/>
                                    <CheckBox Content="بقدونس" Style="{StaticResource ChipCheckBox}"/>
                                    <CheckBox Content="قزبر" Style="{StaticResource ChipCheckBox}"/>
                                    <CheckBox Content="كرفس" Style="{StaticResource ChipCheckBox}"/>
                                    <CheckBox Content="نعناع" Style="{StaticResource ChipCheckBox}"/>
                                    <CheckBox Content="جرجير" Style="{StaticResource ChipCheckBox}"/>
                                    <CheckBox Content="فجل" Style="{StaticResource ChipCheckBox}"/>
                                    <CheckBox Content="باذنجان" Style="{StaticResource ChipCheckBox}"/>
                                    <CheckBox Content="فطر" Style="{StaticResource ChipCheckBox}"/>
                                    <CheckBox Content="هليون" Style="{StaticResource ChipCheckBox}"/>
                                    <CheckBox Content="خرشوف" Style="{StaticResource ChipCheckBox}"/>
                                    <CheckBox Content="بامية" Style="{StaticResource ChipCheckBox}"/>
                                    <CheckBox Content="زيتون" Style="{StaticResource ChipCheckBox}"/>
                                    <CheckBox Content="لفت" Style="{StaticResource ChipCheckBox}"/>
                                    <CheckBox Content="سلق" Style="{StaticResource ChipCheckBox}"/>
                                    <CheckBox Content="طماطم كريز" Style="{StaticResource ChipCheckBox}"/>
                                    <CheckBox Content="فلفل حار" Style="{StaticResource ChipCheckBox}"/>
                                </WrapPanel>

                                <TextBlock Text="🍲 4. البقوليات والقطاني:" Foreground="{DynamicResource AccentAmber}" FontWeight="Bold" FontSize="13" Margin="0,0,0,8"/>
                                <WrapPanel x:Name="PanelLegumes" Margin="0,0,0,15">
                                    <CheckBox Content="اللوبيا" Style="{StaticResource ChipCheckBox}"/>
                                    <CheckBox Content="العدس" Style="{StaticResource ChipCheckBox}"/>
                                    <CheckBox Content="الحمص" Style="{StaticResource ChipCheckBox}"/>
                                    <CheckBox Content="الفول" Style="{StaticResource ChipCheckBox}"/>
                                    <CheckBox Content="فاصوليا سوداء" Style="{StaticResource ChipCheckBox}"/>
                                    <CheckBox Content="بازلاء جافة" Style="{StaticResource ChipCheckBox}"/>
                                    <CheckBox Content="فول الصويا" Style="{StaticResource ChipCheckBox}"/>
                                    <CheckBox Content="الترمس" Style="{StaticResource ChipCheckBox}"/>
                                    <CheckBox Content="الطحينة" Style="{StaticResource ChipCheckBox}"/>
                                    <CheckBox Content="فاصوليا بيضاء" Style="{StaticResource ChipCheckBox}"/>
                                    <CheckBox Content="فاصوليا حمراء" Style="{StaticResource ChipCheckBox}"/>
                                    <CheckBox Content="شوربة العدس" Style="{StaticResource ChipCheckBox}"/>
                                    <CheckBox Content="الفلافل" Style="{StaticResource ChipCheckBox}"/>
                                </WrapPanel>

                                <TextBlock Text="🥑 5. الدهون والمكسرات والزيوت:" Foreground="{DynamicResource AccentAmber}" FontWeight="Bold" FontSize="13" Margin="0,0,0,8"/>
                                <WrapPanel x:Name="PanelFats" Margin="0,0,0,25">
                                    <CheckBox Content="زبدة الفول السوداني" Style="{StaticResource ChipCheckBox}"/>
                                    <CheckBox Content="لوز" Style="{StaticResource ChipCheckBox}"/>
                                    <CheckBox Content="كركاع" Style="{StaticResource ChipCheckBox}"/>
                                    <CheckBox Content="زيت الزيتون" Style="{StaticResource ChipCheckBox}" IsChecked="True"/>
                                    <CheckBox Content="زيت نباتي" Style="{StaticResource ChipCheckBox}"/>
                                    <CheckBox Content="زبدة" Style="{StaticResource ChipCheckBox}"/>
                                    <CheckBox Content="زيت جوز الهند" Style="{StaticResource ChipCheckBox}"/>
                                    <CheckBox Content="أفوكادو" Style="{StaticResource ChipCheckBox}"/>
                                    <CheckBox Content="بذور الكتان" Style="{StaticResource ChipCheckBox}"/>
                                    <CheckBox Content="بذور الشيا" Style="{StaticResource ChipCheckBox}"/>
                                    <CheckBox Content="بذور اليقطين" Style="{StaticResource ChipCheckBox}"/>
                                    <CheckBox Content="بذور دوار الشمس" Style="{StaticResource ChipCheckBox}"/>
                                    <CheckBox Content="كاجو" Style="{StaticResource ChipCheckBox}"/>
                                    <CheckBox Content="بندق" Style="{StaticResource ChipCheckBox}"/>
                                    <CheckBox Content="فستق" Style="{StaticResource ChipCheckBox}"/>
                                    <CheckBox Content="جوز الأمريكي" Style="{StaticResource ChipCheckBox}"/>
                                    <CheckBox Content="سمسم" Style="{StaticResource ChipCheckBox}"/>
                                    <CheckBox Content="طحينة" Style="{StaticResource ChipCheckBox}"/>
                                    <CheckBox Content="شوكولاتة سوداء" Style="{StaticResource ChipCheckBox}"/>
                                    <CheckBox Content="كريمة الخفق" Style="{StaticResource ChipCheckBox}"/>
                                    <CheckBox Content="مكسرات مشكلة" Style="{StaticResource ChipCheckBox}"/>
                                </WrapPanel>

                                <Button x:Name="BtnGenerateMeal" Content="توليد الوجبة بالذكاء الاصطناعي 🪄" Style="{DynamicResource PrimaryButton}" Height="55" Margin="0,0,0,10" Click="BtnGenerateMeal_Click"/>
                            </StackPanel>
                        </ScrollViewer>
                    </Border>

                    <!-- جهة التقرير والشات -->
                    <Grid Grid.Column="1" Margin="8,0,0,0">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="1.9*"/>
                            <RowDefinition Height="1.1*"/>
                        </Grid.RowDefinitions>

                        <Border Grid.Row="0" Style="{DynamicResource GlassCard}" Padding="15" Margin="0,0,0,12">
                            <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="0,0,10,10">
                                <StackPanel>
                                    <DockPanel Margin="0,0,0,20">
                                        <TextBlock Text="📋 التقرير الغذائي الذكي" Foreground="{DynamicResource TextPrimary}" FontWeight="Bold" FontSize="16" VerticalAlignment="Center"/>
                                        <Button x:Name="BtnSaveMeal" Content="🔖 حفظ الوجبة" DockPanel.Dock="Left" Style="{DynamicResource PrimaryButton}" Padding="12,6" FontSize="12" Click="BtnSaveMeal_Click" Visibility="Collapsed"/>
                                    </DockPanel>

                                    <StackPanel x:Name="PanelEmptyReport" VerticalAlignment="Center" Margin="0,50,0,0">
                                        <TextBlock Text="🍽️" FontSize="42" HorizontalAlignment="Center" Margin="0,0,0,10"/>
                                        <TextBlock Text="في انتظار توليد وصفتك الذكية" Foreground="{DynamicResource TextPrimary}" FontWeight="Bold" FontSize="15" HorizontalAlignment="Center" Margin="0,0,0,8"/>
                                        <TextBlock Text="اختر مكوناتك المتاحة أو ارفع صورة الثلاجة واضغط على توليد الوجبة." Foreground="{DynamicResource TextMuted}" FontSize="13" TextAlignment="Center" TextWrapping="Wrap"/>
                                    </StackPanel>

                                    <StackPanel x:Name="PanelMealDetails" Visibility="Collapsed">
                                        <Border Background="#26f59e0b" BorderBrush="{DynamicResource AccentAmber}" BorderThickness="0,0,4,0" Padding="12" CornerRadius="8" Margin="0,0,0,15">
                                            <DockPanel>
                                                <TextBlock x:Name="LblGeneratedMealTitle" Text="" Foreground="{DynamicResource AccentAmber}" FontWeight="ExtraBold" FontSize="15" VerticalAlignment="Center"/>
                                                <TextBlock x:Name="LblMealCaloriesBadge" Text="700 Kcal" Foreground="#10b981" FontWeight="Bold" FontSize="13" DockPanel.Dock="Left" VerticalAlignment="Center"/>
                                            </DockPanel>
                                        </Border>

                                        <TextBlock Text="المقادير الموزونة بدقة:" Foreground="{DynamicResource TextMuted}" FontWeight="Bold" FontSize="13" Margin="0,0,0,10"/>
                                        <StackPanel x:Name="ContainerIngredientsCards" Margin="0,0,0,15"/>

                                        <TextBlock Text="طريقة التحضير:" Foreground="{DynamicResource TextMuted}" FontWeight="Bold" FontSize="13" Margin="0,0,0,10"/>
                                        <StackPanel x:Name="ContainerStepsCards" Margin="0,0,0,20"/>

                                        <StackPanel Margin="0,0,0,10">
                                            <TextBlock Text="القيم الغذائية:" Foreground="{DynamicResource TextPrimary}" FontWeight="Bold" FontSize="14" Margin="0,0,0,8"/>
                                            <TextBlock x:Name="LblTotalCaloriesText" Text="- إجمالي السعرات الحرارية: ~700 Kcal" Foreground="{DynamicResource TextPrimary}" FontWeight="SemiBold" FontSize="13" Margin="0,0,0,12"/>

                                            <Border Background="{DynamicResource BgInput}" BorderBrush="{DynamicResource BorderGlass}" BorderThickness="1" CornerRadius="8" Padding="12,10" Margin="0,0,0,8">
                                                <StackPanel Orientation="Horizontal">
                                                    <TextBlock Text="🍴" Foreground="{DynamicResource AccentAmber}" FontSize="14" Margin="0,0,0,8" VerticalAlignment="Center"/>
                                                    <TextBlock x:Name="LblCardProtein" Text="- البروتين: ~52 غرام" Foreground="{DynamicResource TextPrimary}" FontWeight="Bold" FontSize="13" VerticalAlignment="Center"/>
                                                </StackPanel>
                                            </Border>

                                            <Border Background="{DynamicResource BgInput}" BorderBrush="{DynamicResource BorderGlass}" BorderThickness="1" CornerRadius="8" Padding="12,10" Margin="0,0,0,8">
                                                <StackPanel Orientation="Horizontal">
                                                    <TextBlock Text="🍴" Foreground="{DynamicResource AccentAmber}" FontSize="14" Margin="0,0,0,8" VerticalAlignment="Center"/>
                                                    <TextBlock x:Name="LblCardCarbs" Text="- الكربوهيدرات: ~78 غرام" Foreground="{DynamicResource TextPrimary}" FontWeight="Bold" FontSize="13" VerticalAlignment="Center"/>
                                                </StackPanel>
                                            </Border>

                                            <Border Background="{DynamicResource BgInput}" BorderBrush="{DynamicResource BorderGlass}" BorderThickness="1" CornerRadius="8" Padding="12,10" Margin="0,0,0,8">
                                                <StackPanel Orientation="Horizontal">
                                                    <TextBlock Text="🍴" Foreground="{DynamicResource AccentAmber}" FontSize="14" Margin="0,0,0,8" VerticalAlignment="Center"/>
                                                    <TextBlock x:Name="LblCardFat" Text="- الدهون: ~20 غرام" Foreground="{DynamicResource TextPrimary}" FontWeight="Bold" FontSize="13" VerticalAlignment="Center"/>
                                                </StackPanel>
                                            </Border>
                                        </StackPanel>
                                    </StackPanel>
                                </StackPanel>
                            </ScrollViewer>
                        </Border>

                        <Border Grid.Row="1" Style="{DynamicResource GlassCard}" Padding="15" Margin="0,0,0,0">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="*"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>

                                <TextBlock Grid.Row="0" Text="💬 اسأل المدرب الذكي" Foreground="{DynamicResource AccentAmber}" FontWeight="Bold" FontSize="14" Margin="0,0,0,10"/>

                                <Border Grid.Row="1" Background="{DynamicResource BgInput}" BorderBrush="{DynamicResource BorderGlass}" BorderThickness="1" CornerRadius="8" Padding="12" Margin="0,0,0,12">
                                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                                        <TextBlock x:Name="TxtChatReply" Text="أهلاً بك كابتن! اسألني عن أي بديل غذائي، نصيحة رياضية أو طريقة طهي صحية." Foreground="{DynamicResource TextPrimary}" FontSize="13" TextWrapping="Wrap"/>
                                    </ScrollViewer>
                                </Border>

                                <DockPanel Grid.Row="2">
                                    <Button Content="إرسال 🚀" DockPanel.Dock="Left" Style="{DynamicResource PrimaryButton}" Padding="15,8" Margin="8,0,0,0" Click="BtnSendChat_Click"/>
                                    <TextBox x:Name="TxtChatQuestion" KeyDown="TxtChatQuestion_KeyDown"/>
                                </DockPanel>
                            </Grid>
                        </Border>
                    </Grid>
                </Grid>

                <!-- شاشة 2: حاسبة السعرات -->
                <Grid x:Name="ViewCalculator" Visibility="Collapsed">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="3*"/>
                        <ColumnDefinition Width="2*"/>
                    </Grid.ColumnDefinitions>

                    <Border Grid.Column="0" Style="{DynamicResource GlassCard}" Padding="25" Margin="0,0,8,0">
                        <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="0,0,10,10">
                            <StackPanel>
                                <TextBlock Text="حاسبة السعرات والماكروز" Foreground="{DynamicResource AccentAmber}" FontWeight="Bold" FontSize="18" Margin="0,0,0,15"/>

                                <TextBlock Text="الوزن (kg):" Foreground="{DynamicResource TextMuted}" FontSize="13" FontWeight="SemiBold" Margin="0,0,0,4"/>
                                <TextBox x:Name="TxtWeight" Text="65" Height="38" VerticalContentAlignment="Center" Padding="15,0" TextChanged="CalculatorInput_Changed" Margin="0,0,0,12"/>

                                <TextBlock Text="الطول (cm):" Foreground="{DynamicResource TextMuted}" FontSize="13" FontWeight="SemiBold" Margin="0,0,0,4"/>
                                <TextBox x:Name="TxtHeight" Text="185" Height="38" VerticalContentAlignment="Center" Padding="15,0" TextChanged="CalculatorInput_Changed" Margin="0,0,0,12"/>

                                <TextBlock Text="العمر:" Foreground="{DynamicResource TextMuted}" FontSize="13" FontWeight="SemiBold" Margin="0,0,0,4"/>
                                <TextBox x:Name="TxtAge" Text="25" Height="38" VerticalContentAlignment="Center" Padding="15,0" TextChanged="CalculatorInput_Changed" Margin="0,0,0,12"/>

                                <TextBlock Text="الجنس:" Foreground="{DynamicResource TextMuted}" FontSize="13" FontWeight="SemiBold" Margin="0,0,0,4"/>
                                <ComboBox x:Name="CmbGender" SelectedIndex="0" Height="38" Style="{DynamicResource GlassComboBox}" SelectionChanged="CalculatorCombo_Changed" Margin="0,0,0,12">
                                    <ComboBoxItem Content="ذكر" Tag="male"/>
                                    <ComboBoxItem Content="أنثى" Tag="female"/>
                                </ComboBox>

                                <TextBlock Text="الهدف الرياضي:" Foreground="{DynamicResource TextMuted}" FontSize="13" FontWeight="SemiBold" Margin="0,0,0,4"/>
                                <ComboBox x:Name="CmbGoal" SelectedIndex="0" Height="38" Style="{DynamicResource GlassComboBox}" SelectionChanged="CalculatorCombo_Changed" Margin="0,0,0,12">
                                    <ComboBoxItem Content="تضخيم عضلي (Bulking)" Tag="bulking"/>
                                    <ComboBoxItem Content="تنشيف وحرق دهون (Cutting)" Tag="cutting"/>
                                    <ComboBoxItem Content="محافظة على الوزن (Maintenance)" Tag="maintenance"/>
                                </ComboBox>

                                <TextBlock Text="معدل النشاط البدني:" Foreground="{DynamicResource TextMuted}" FontSize="13" FontWeight="SemiBold" Margin="0,0,0,4"/>
                                <ComboBox x:Name="CmbActivity" SelectedIndex="0" Height="38" Style="{DynamicResource GlassComboBox}" SelectionChanged="CalculatorCombo_Changed" Margin="0,0,0,20">
                                    <ComboBoxItem Content="خفيف (بدون تمرين تقريباً)" Tag="1.2"/>
                                    <ComboBoxItem Content="متوسط (تمرين 3-5 أيام أسبوعياً)" Tag="1.55"/>
                                    <ComboBoxItem Content="عالي (تمرين شاق 6-7 أيام)" Tag="1.725"/>
                                </ComboBox>

                                <Button Content="احسب السعرات والماكروز 🧮" Style="{DynamicResource PrimaryButton}" Height="45" Margin="0,0,0,5" Click="BtnCalculate_Click"/>
                            </StackPanel>
                        </ScrollViewer>
                    </Border>

                    <Border Grid.Column="1" Style="{DynamicResource GlassCard}" Padding="25" Margin="8,0,0,0">
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock Text="السعرات اليومية المستهدفة" Foreground="{DynamicResource TextMuted}" FontSize="15" FontWeight="SemiBold" HorizontalAlignment="Center" Margin="0,0,0,10"/>
                            <TextBlock x:Name="LblCalories" Text="0 Kcal" Foreground="{DynamicResource AccentAmber}" FontWeight="ExtraBold" FontSize="42" HorizontalAlignment="Center" Margin="0,0,0,20"/>

                            <UniformGrid Columns="3" Margin="0,0,0,20">
                                <Border Background="{DynamicResource BgInput}" BorderBrush="{DynamicResource BorderGlass}" BorderThickness="1" CornerRadius="12" Padding="15" Margin="5">
                                    <StackPanel>
                                        <TextBlock Text="بروتين" Foreground="{DynamicResource TextMuted}" FontSize="13" FontWeight="SemiBold" HorizontalAlignment="Center" Margin="0,0,0,8"/>
                                        <TextBlock x:Name="LblProtein" Text="0g" Foreground="#10b981" FontWeight="Bold" FontSize="20" HorizontalAlignment="Center"/>
                                    </StackPanel>
                                </Border>
                                <Border Background="{DynamicResource BgInput}" BorderBrush="{DynamicResource BorderGlass}" BorderThickness="1" CornerRadius="12" Padding="15" Margin="5">
                                    <StackPanel>
                                        <TextBlock Text="كربوهيدرات" Foreground="{DynamicResource TextMuted}" FontSize="13" FontWeight="SemiBold" HorizontalAlignment="Center" Margin="0,0,0,8"/>
                                        <TextBlock x:Name="LblCarbs" Text="0g" Foreground="{DynamicResource AccentAmber}" FontWeight="Bold" FontSize="20" HorizontalAlignment="Center"/>
                                    </StackPanel>
                                </Border>
                                <Border Background="{DynamicResource BgInput}" BorderBrush="{DynamicResource BorderGlass}" BorderThickness="1" CornerRadius="12" Padding="15" Margin="5">
                                    <StackPanel>
                                        <TextBlock Text="دهون" Foreground="{DynamicResource TextMuted}" FontSize="13" FontWeight="SemiBold" HorizontalAlignment="Center" Margin="0,0,0,8"/>
                                        <TextBlock x:Name="LblFat" Text="0g" Foreground="#f87171" FontWeight="Bold" FontSize="20" HorizontalAlignment="Center"/>
                                    </StackPanel>
                                </Border>
                            </UniformGrid>

                            <Button Content="توليد وجبات بهذه السعرات 👈" Style="{DynamicResource GlassButton}" Foreground="{DynamicResource AccentAmber}" BorderBrush="{DynamicResource AccentAmber}" Height="45" Click="TransferToPlanner_Click"/>
                        </StackPanel>
                    </Border>
                </Grid>

                <!-- شاشة 3: الوجبات المحفوظة (الكروت الديناميكية المطابقة للموقع 100%) -->
                <Grid x:Name="ViewSavedMeals" Visibility="Collapsed">
                    <Border Style="{DynamicResource GlassCard}" Padding="25">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>

                            <StackPanel Grid.Row="0" Margin="0,0,0,20">
                                <TextBlock Text="🔖 الوجبات المحفوظة في الأرشيف" Foreground="{DynamicResource AccentAmber}" FontWeight="Bold" FontSize="20" Margin="0,0,0,8"/>
                                <TextBlock Text="قائمة بجميع وصفاتك المحفوظة منظمة على شكل كروت ديناميكية متطابقة مع الموقع." Foreground="{DynamicResource TextMuted}" FontSize="14"/>
                            </StackPanel>

                            <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                                <ItemsControl x:Name="LstSavedMeals">
                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate>
                                            <WrapPanel Orientation="Horizontal" HorizontalAlignment="Right"/>
                                        </ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <!-- الكارت الديناميكي الزجاجي الفخم -->
                                            <Border Width="460" Background="{DynamicResource BgInput}" BorderBrush="{DynamicResource BorderGlass}" BorderThickness="1" CornerRadius="16" Margin="10,10,10,20" Padding="22">
                                                <Border.Style>
                                                    <Style TargetType="Border">
                                                        <Style.Triggers>
                                                            <Trigger Property="IsMouseOver" Value="True">
                                                                <Setter Property="BorderBrush" Value="{DynamicResource AccentAmber}"/>
                                                                <Setter Property="Background" Value="#1AFFFFFF"/>
                                                                <Setter Property="Effect">
                                                                    <Setter.Value>
                                                                        <DropShadowEffect Color="#f59e0b" BlurRadius="25" ShadowDepth="0" Opacity="0.3"/>
                                                                    </Setter.Value>
                                                                </Setter>
                                                            </Trigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </Border.Style>

                                                <StackPanel>
                                                    <!-- الهيدر: العنوان وزر الحذف -->
                                                    <DockPanel Margin="0,0,0,15">
                                                        <Button DockPanel.Dock="Left" Content="🗑️ حذف" Style="{DynamicResource GlassButton}" Background="#1Af87171" BorderBrush="#80f87171" Foreground="#f87171" Padding="12,6" FontSize="12" Tag="{Binding Id}" Click="BtnDeleteSavedMeal_Click"/>
                                                        <Border DockPanel.Dock="Left" Background="#1A10B981" BorderBrush="#8010B981" BorderThickness="1" CornerRadius="6" Padding="10,4" Margin="10,0,0,0" VerticalAlignment="Center">
                                                            <TextBlock Text="{Binding Calories}" Foreground="#10b981" FontWeight="ExtraBold" FontSize="12"/>
                                                        </Border>
                                                        <TextBlock Text="{Binding Title}" Foreground="{DynamicResource AccentAmber}" FontWeight="ExtraBold" FontSize="16" TextWrapping="Wrap" TextAlignment="Right" VerticalAlignment="Center"/>
                                                    </DockPanel>

                                                    <Border BorderBrush="{DynamicResource BorderGlass}" BorderThickness="0,0,0,1" Margin="0,5,0,15"/>

                                                    <!-- المقادير -->
                                                    <TextBlock Text="المقادير والمكونات:" Foreground="{DynamicResource AccentAmber}" FontWeight="Bold" FontSize="13" Margin="0,0,0,8"/>
                                                    <ItemsControl ItemsSource="{Binding Ingredients}">
                                                        <ItemsControl.ItemTemplate>
                                                            <DataTemplate>
                                                                <Border Background="#0AFFFFFF" BorderBrush="{DynamicResource BorderGlass}" BorderThickness="1" CornerRadius="8" Padding="12,8" Margin="0,0,0,6">
                                                                    <StackPanel Orientation="Horizontal">
                                                                        <TextBlock Text="🍴" Foreground="{DynamicResource AccentAmber}" FontSize="12" Margin="0,0,8,0" VerticalAlignment="Center"/>
                                                                        <TextBlock Text="{Binding}" Foreground="{DynamicResource TextPrimary}" FontWeight="SemiBold" FontSize="13" TextWrapping="Wrap" VerticalAlignment="Center"/>
                                                                    </StackPanel>
                                                                </Border>
                                                            </DataTemplate>
                                                        </ItemsControl.ItemTemplate>
                                                    </ItemsControl>

                                                    <!-- طريقة التحضير -->
                                                    <TextBlock Text="طريقة التحضير:" Foreground="{DynamicResource AccentAmber}" FontWeight="Bold" FontSize="13" Margin="0,15,0,8"/>
                                                    <Border Background="#0AFFFFFF" BorderBrush="{DynamicResource BorderGlass}" BorderThickness="1" CornerRadius="8" Padding="15">
                                                        <TextBlock Text="{Binding Instructions}" Foreground="{DynamicResource TextPrimary}" FontSize="13" TextWrapping="Wrap" LineHeight="22"/>
                                                    </Border>

                                                    <!-- القيم الغذائية التقديرية (Macros) -->
                                                    <TextBlock Text="القيم الغذائية التقديرية:" Foreground="{DynamicResource AccentAmber}" FontWeight="Bold" FontSize="13" Margin="0,20,0,8"/>
                                                    <UniformGrid Columns="4">
                                                        <Border Background="{DynamicResource BgInput}" BorderBrush="{DynamicResource BorderGlass}" BorderThickness="1" CornerRadius="8" Padding="10" Margin="4">
                                                            <StackPanel>
                                                                <TextBlock Text="💧" HorizontalAlignment="Center" Margin="0,0,0,4"/>
                                                                <TextBlock Text="الدهون" Foreground="{DynamicResource TextMuted}" FontSize="11" HorizontalAlignment="Center"/>
                                                                <TextBlock Text="{Binding Fat}" Foreground="{DynamicResource TextPrimary}" FontWeight="Bold" FontSize="13" HorizontalAlignment="Center"/>
                                                            </StackPanel>
                                                        </Border>
                                                        <Border Background="{DynamicResource BgInput}" BorderBrush="{DynamicResource BorderGlass}" BorderThickness="1" CornerRadius="8" Padding="10" Margin="4">
                                                            <StackPanel>
                                                                <TextBlock Text="🌾" HorizontalAlignment="Center" Margin="0,0,0,4"/>
                                                                <TextBlock Text="الكارب" Foreground="{DynamicResource TextMuted}" FontSize="11" HorizontalAlignment="Center"/>
                                                                <TextBlock Text="{Binding Carbs}" Foreground="{DynamicResource TextPrimary}" FontWeight="Bold" FontSize="13" HorizontalAlignment="Center"/>
                                                            </StackPanel>
                                                        </Border>
                                                        <Border Background="{DynamicResource BgInput}" BorderBrush="{DynamicResource BorderGlass}" BorderThickness="1" CornerRadius="8" Padding="10" Margin="4">
                                                            <StackPanel>
                                                                <TextBlock Text="🏋️" HorizontalAlignment="Center" Margin="0,0,0,4"/>
                                                                <TextBlock Text="البروتين" Foreground="{DynamicResource TextMuted}" FontSize="11" HorizontalAlignment="Center"/>
                                                                <TextBlock Text="{Binding Protein}" Foreground="{DynamicResource TextPrimary}" FontWeight="Bold" FontSize="13" HorizontalAlignment="Center"/>
                                                            </StackPanel>
                                                        </Border>
                                                        <Border Background="{DynamicResource BgInput}" BorderBrush="{DynamicResource BorderGlass}" BorderThickness="1" CornerRadius="8" Padding="10" Margin="4">
                                                            <StackPanel>
                                                                <TextBlock Text="🔥" HorizontalAlignment="Center" Margin="0,0,0,4"/>
                                                                <TextBlock Text="السعرات" Foreground="{DynamicResource TextMuted}" FontSize="11" HorizontalAlignment="Center"/>
                                                                <TextBlock Text="{Binding Calories}" Foreground="{DynamicResource TextPrimary}" FontWeight="Bold" FontSize="13" HorizontalAlignment="Center"/>
                                                            </StackPanel>
                                                        </Border>
                                                    </UniformGrid>
                                                </StackPanel>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </ScrollViewer>
                        </Grid>
                    </Border>
                </Grid>

            </Grid>
        </Grid>

        <!-- نافذة الملف الشخصي (Modal) -->
        <Grid x:Name="ModalProfile" Visibility="Collapsed" Background="#B3000000" Panel.ZIndex="2000" FlowDirection="RightToLeft">
            <Border Style="{DynamicResource GlassCard}" Width="480" Padding="35" VerticalAlignment="Center" HorizontalAlignment="Center">
                <StackPanel>
                    <Grid Margin="0,0,0,25">
                        <TextBlock Text="الملف الشخصي للكابتن" Foreground="{DynamicResource TextPrimary}" FontWeight="Bold" FontSize="18" VerticalAlignment="Center"/>
                        <Button Content="✕" HorizontalAlignment="Left" VerticalAlignment="Center" Foreground="{DynamicResource TextMuted}" FontWeight="Bold" FontSize="18" Click="CloseProfileModal_Click" Cursor="Hand" Margin="10,0,0,0">
                            <Button.Template>
                                <ControlTemplate TargetType="Button">
                                    <Border Background="Transparent" Padding="5">
                                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Border>
                                </ControlTemplate>
                            </Button.Template>
                        </Button>
                    </Grid>

                    <StackPanel Orientation="Horizontal" Margin="0,0,0,25">
                        <Border Width="80" Height="80" CornerRadius="40" BorderBrush="{DynamicResource AccentAmber}" BorderThickness="2" Margin="0,0,0,20" Background="{DynamicResource BgInput}">
                            <Image x:Name="ImgModalAvatar" Stretch="UniformToFill">
                                <Image.Clip>
                                    <EllipseGeometry Center="40,40" RadiusX="40" RadiusY="40"/>
                                </Image.Clip>
                            </Image>
                        </Border>
                        <Button Content="تغيير الصورة 📷" VerticalAlignment="Center" Style="{DynamicResource GlassButton}" Click="ChangeAvatar_Click"/>
                    </StackPanel>

                    <TextBlock Text="الاسم الكامل:" Foreground="{DynamicResource TextMuted}" FontSize="13" FontWeight="SemiBold" Margin="0,0,0,6"/>
                    <TextBox x:Name="TxtProfileName" Text="أدهم الشرقاوي" Margin="0,0,0,20"/>

                    <UniformGrid Columns="3" Margin="0,0,0,25">
                        <StackPanel Margin="5">
                            <TextBlock Text="الوزن (kg)" Foreground="{DynamicResource TextMuted}" FontSize="12" FontWeight="SemiBold" Margin="0,0,0,6"/>
                            <TextBox x:Name="TxtProfileWeight" Text="65"/>
                        </StackPanel>
                        <StackPanel Margin="5">
                            <TextBlock Text="الطول (cm)" Foreground="{DynamicResource TextMuted}" FontSize="12" FontWeight="SemiBold" Margin="0,0,0,6"/>
                            <TextBox x:Name="TxtProfileHeight" Text="185"/>
                        </StackPanel>
                        <StackPanel Margin="5">
                            <TextBlock Text="العمر" Foreground="{DynamicResource TextMuted}" FontSize="12" FontWeight="SemiBold" Margin="0,0,0,6"/>
                            <TextBox x:Name="TxtProfileAge" Text="25"/>
                        </StackPanel>
                    </UniformGrid>

                    <Button Content="حفظ التغييرات ✔️" Style="{DynamicResource PrimaryButton}" Height="50" Click="SaveProfile_Click"/>
                </StackPanel>
            </Border>
        </Grid>
    </Grid>
</Window>