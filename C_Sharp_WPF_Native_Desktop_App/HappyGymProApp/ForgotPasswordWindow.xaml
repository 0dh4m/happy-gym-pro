<Window x:Class="HappyGymProApp.ForgotPasswordWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Happy Gym PRO | استرجاع كلمة المرور" Height="650" Width="500"
        Background="{DynamicResource BgDeep}"
        WindowStartupLocation="CenterScreen"
        ResizeMode="NoResize"
        WindowStyle="None"
        AllowsTransparency="True"
        Loaded="Window_Loaded"
        MouseMove="Window_MouseMove">

    <Grid Height="650" Margin="0,0,0,-0.4" VerticalAlignment="Bottom">
        <!-- 1. كانفاس الفضاء (الخلفية اللي غنرسمو فيها الجزيئات) -->
        <Canvas x:Name="SpaceCanvas" IsHitTestVisible="False" Panel.ZIndex="-1" Margin="0,0,0,-0.4" Height="606" VerticalAlignment="Bottom"/>

        <!-- 2. مؤشر الماوس المخصص (برتقالي متناسق) -->
        <Canvas x:Name="CustomCursorCanvas" IsHitTestVisible="False" Panel.ZIndex="9999" Margin="0,44,0,-0.4">
            <Grid x:Name="CustomCursor" Width="40" Height="40">
                <Border x:Name="CursorLineT" Width="1" Height="8" Background="{DynamicResource AccentAmber}" HorizontalAlignment="Center" VerticalAlignment="Top" Margin="0,4,0,0"/>
                <Border x:Name="CursorLineB" Width="1" Height="8" Background="{DynamicResource AccentAmber}" HorizontalAlignment="Center" VerticalAlignment="Bottom" Margin="0,0,0,4"/>
                <Border x:Name="CursorLineL" Width="8" Height="1" Background="{DynamicResource AccentAmber}" HorizontalAlignment="Left" VerticalAlignment="Center" Margin="4,0,0,0"/>
                <Border x:Name="CursorLineR" Width="8" Height="1" Background="{DynamicResource AccentAmber}" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,4,0"/>
                <Ellipse x:Name="CursorDot" Width="3" Height="3" Fill="{DynamicResource AccentAmber}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
            </Grid>
        </Canvas>

        <!-- 3. زر تبديل المظهر (زجاجي) -->
        <Button x:Name="BtnThemeToggle" Width="40" Height="40" Style="{DynamicResource GlassButton}" VerticalAlignment="Top" HorizontalAlignment="Left" Margin="30,142,0,0" Click="BtnThemeToggle_Click" Panel.ZIndex="1000">
            <TextBlock x:Name="TxtThemeIcon" Text="🌙" FontSize="18" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0,0,0,2"/>
        </Button>

        <!-- 4. البطاقة الزجاجية الرئيسية -->
        <Border Style="{DynamicResource GlassCard}" Margin="30,50,30,30" Padding="30" VerticalAlignment="Center">
            <StackPanel FlowDirection="RightToLeft">

                <StackPanel HorizontalAlignment="Center" Margin="0,0,0,20">
                    <Border Background="#2610b981" Width="60" Height="60" CornerRadius="18" HorizontalAlignment="Center" Margin="0,0,0,15">
                        <TextBlock Text="💬" FontSize="26" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <TextBlock Text="استرجاع كلمة المرور" Foreground="{DynamicResource TextPrimary}" FontWeight="ExtraBold" FontSize="20" HorizontalAlignment="Center"/>
                    <TextBlock x:Name="TxtSubTitle" Text="أدخل رقم هاتفك لتلقي رمز التحقق (OTP) عبر الواتساب" Foreground="{DynamicResource TextMuted}" FontSize="13" HorizontalAlignment="Center" Margin="0,4,0,0" TextAlignment="Center"/>
                </StackPanel>

                <!-- رسالة الخطأ أو النجاح -->
                <Border x:Name="BorderMsg" CornerRadius="10" Padding="12" Margin="0,0,0,15" Visibility="Collapsed">
                    <TextBlock x:Name="TxtStatusMsg" Text="" FontSize="13" TextWrapping="Wrap" TextAlignment="Center" FontWeight="SemiBold"/>
                </Border>

                <!-- المرحلة 1: إدخال رقم الهاتف -->
                <StackPanel x:Name="PanelPhoneStep">
                    <TextBlock Text="رقم الواتساب المسجل:" Foreground="{DynamicResource TextMuted}" FontSize="13" FontWeight="SemiBold" Margin="0,0,0,6"/>

                    <Grid FlowDirection="LeftToRight" Margin="0,0,0,20">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="150"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <!-- ComboBox مُحدث لدعم الوضعين (زجاجي) -->
                        <ComboBox x:Name="CmbCountry" Grid.Column="0" SelectedValuePath="Code" Padding="8,8" 
                                  Background="{DynamicResource BgInput}" 
                                  Foreground="{DynamicResource TextPrimary}" 
                                  BorderBrush="{DynamicResource BorderGlass}" 
                                  Margin="0,0,8,0">
                            <ComboBox.Style>
                                <Style TargetType="ComboBox">
                                    <Setter Property="Background" Value="{DynamicResource BgInput}"/>
                                    <Setter Property="Foreground" Value="{DynamicResource TextPrimary}"/>
                                    <Setter Property="BorderBrush" Value="{DynamicResource BorderGlass}"/>
                                    <Setter Property="Template">
                                        <Setter.Value>
                                            <ControlTemplate TargetType="ComboBox">
                                                <Grid>
                                                    <Border x:Name="Border" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="1" CornerRadius="12">
                                                        <Grid>
                                                            <ToggleButton x:Name="ToggleButton" Background="Transparent" BorderBrush="Transparent" Focusable="false" IsChecked="{Binding IsDropDownOpen, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}" ClickMode="Press">
                                                                <ToggleButton.Template>
                                                                    <ControlTemplate TargetType="ToggleButton">
                                                                        <Border Background="Transparent">
                                                                            <Path x:Name="Arrow" Data="M 0 0 L 4 4 L 8 0 Z" Fill="{DynamicResource TextPrimary}" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,12,0"/>
                                                                        </Border>
                                                                    </ControlTemplate>
                                                                </ToggleButton.Template>
                                                            </ToggleButton>
                                                            <ContentPresenter x:Name="ContentSite" IsHitTestVisible="False" Content="{TemplateBinding SelectionBoxItem}" ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}" ContentTemplateSelector="{TemplateBinding ItemTemplateSelector}" Margin="12,0,30,0" VerticalAlignment="Center" HorizontalAlignment="Right"/>
                                                        </Grid>
                                                    </Border>
                                                    <Popup x:Name="Popup" Placement="Bottom" IsOpen="{TemplateBinding IsDropDownOpen}" AllowsTransparency="True" Focusable="False" PopupAnimation="Slide">
                                                        <Border x:Name="DropDownBorder" Background="{DynamicResource BgSurface}" BorderBrush="{DynamicResource BorderGlass}" BorderThickness="1" CornerRadius="8" MaxHeight="{TemplateBinding MaxDropDownHeight}" MinWidth="{TemplateBinding ActualWidth}" Margin="0,4,0,0">
                                                            <ScrollViewer x:Name="DropDownScrollViewer" Margin="4" SnapsToDevicePixels="True">
                                                                <ItemsPresenter x:Name="ItemsPresenter" KeyboardNavigation.DirectionalNavigation="Contained"/>
                                                            </ScrollViewer>
                                                        </Border>
                                                    </Popup>
                                                </Grid>
                                            </ControlTemplate>
                                        </Setter.Value>
                                    </Setter>
                                </Style>
                            </ComboBox.Style>
                            <ComboBox.ItemContainerStyle>
                                <Style TargetType="ComboBoxItem">
                                    <Setter Property="Background" Value="Transparent"/>
                                    <Setter Property="Foreground" Value="{DynamicResource TextPrimary}"/>
                                    <Setter Property="Template">
                                        <Setter.Value>
                                            <ControlTemplate TargetType="ComboBoxItem">
                                                <Border x:Name="ItemBorder" Background="Transparent" Padding="10,8" CornerRadius="6">
                                                    <ContentPresenter/>
                                                </Border>
                                                <ControlTemplate.Triggers>
                                                    <Trigger Property="IsMouseOver" Value="True">
                                                        <Setter TargetName="ItemBorder" Property="Background" Value="{DynamicResource BgInput}"/>
                                                    </Trigger>
                                                </ControlTemplate.Triggers>
                                            </ControlTemplate>
                                        </Setter.Value>
                                    </Setter>
                                </Style>
                            </ComboBox.ItemContainerStyle>
                            <ComboBox.ItemTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding DisplayText}" Foreground="{DynamicResource TextPrimary}" FontSize="13" FontWeight="SemiBold"/>
                                </DataTemplate>
                            </ComboBox.ItemTemplate>
                        </ComboBox>

                        <!-- خانة الهاتف (تعتمد أوتوماتيكياً على ستايل TextBox من App.xaml) -->
                        <TextBox x:Name="TxtPhone" Grid.Column="1" FontWeight="Bold"/>
                    </Grid>

                    <!-- زر الإرسال -->
                    <Button x:Name="BtnSendOtp" Content="إرسال الرمز عبر WhatsApp 📲" Background="#10b981" Foreground="Black" FontWeight="ExtraBold" Height="50" Click="BtnSendOtp_Click" Cursor="Hand" Margin="0,0,0,15">
                        <Button.Template>
                            <ControlTemplate TargetType="Button">
                                <Border x:Name="border" Background="{TemplateBinding Background}" CornerRadius="12">
                                    <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    <Border.Effect>
                                        <DropShadowEffect Color="#10b981" BlurRadius="20" ShadowDepth="0" Opacity="0.4"/>
                                    </Border.Effect>
                                </Border>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsMouseOver" Value="true">
                                        <Setter TargetName="border" Property="Background" Value="#34d399"/>
                                    </Trigger>
                                    <Trigger Property="IsPressed" Value="true">
                                        <Setter TargetName="border" Property="Background" Value="#059669"/>
                                        <Setter TargetName="border" Property="Effect" Value="{x:Null}"/>
                                    </Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </Button.Template>
                    </Button>
                </StackPanel>

                <!-- المرحلة 2: إدخال الرمز وكلمة المرور الجديدة -->
                <StackPanel x:Name="PanelResetStep" Visibility="Collapsed">
                    <TextBlock Text="رمز التحقق (OTP) المكون من 6 أرقام:" Foreground="{DynamicResource TextMuted}" FontSize="13" FontWeight="SemiBold" Margin="0,0,0,6"/>
                    <TextBox x:Name="TxtOtp" FlowDirection="LeftToRight" TextAlignment="Center" FontWeight="ExtraBold" FontSize="20" Foreground="{DynamicResource AccentAmber}" Margin="0,0,0,15" MaxLength="6" Padding="10"/>

                    <TextBlock Text="كلمة المرور الجديدة:" Foreground="{DynamicResource TextMuted}" FontSize="13" FontWeight="SemiBold" Margin="0,0,0,6"/>
                    <PasswordBox x:Name="TxtNewPassword" FlowDirection="LeftToRight" Margin="0,0,0,15"/>

                    <TextBlock Text="تأكيد كلمة المرور الجديدة:" Foreground="{DynamicResource TextMuted}" FontSize="13" FontWeight="SemiBold" Margin="0,0,0,6"/>
                    <PasswordBox x:Name="TxtConfirmPassword" FlowDirection="LeftToRight" Margin="0,0,0,20"/>

                    <Button x:Name="BtnResetPassword" Content="حفظ وتغيير كلمة المرور 🔐" Style="{DynamicResource PrimaryButton}" Height="50" Click="BtnResetPassword_Click" Margin="0,0,0,15"/>
                </StackPanel>

                <!-- رابط العودة -->
                <TextBlock Text="العودة لتسجيل الدخول" Foreground="{DynamicResource AccentAmber}" FontWeight="Bold" FontSize="13" HorizontalAlignment="Center" Cursor="Hand" MouseDown="BackToLogin_MouseDown" Margin="0,10,0,0"/>

            </StackPanel>
        </Border>
    </Grid>
</Window>